        "runtime",
        "tests.zig",
        "smoke.zig",
        // Cross-test profile.
        "cross-test.profile.sh",
        // Test corpus and interoperability source.
        "testdata",
        // Separate consumer package.
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // Pinned upstream source tree.
        "libraries/liblmdb",
        "UPSTREAM.md",
        "UPSTREAM.sha256",
        "README.zig.md",
        "FORK-NOTES.md",
        "CHANGELOG.md",
        "NOTICE.md",
        // Fork documentation and Nix/devenv integration files.
        "README.md",
        "FORK-LICENSE.md",
        "package.nix",
        "flake.nix",
        // Pin for the flake input.
